{
    "compilerOptions": {
        "target": "ES2025",
        "module": "es2022",
        "moduleResolution": "node",
        "types": ["node"],
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "noImplicitAny": true,
        "noEmitOnError": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/**/__tests__/**", "dist/**/*"]
}
